# scraper0 settings (prefix SCRAPER0_). Copy to .env for local dev. Production values go in Secret Manager.

# --- runtime
SCRAPER0_ENV=local                      # local | staging | production
SCRAPER0_LOG_FORMAT=console             # json in production (Cloud Logging)
SCRAPER0_PORT=5001

# --- database. Local default is a SQLite file under ./data. Production: the hashtaglocal Postgres
# instance, own `scraper0` database + user. Pool is capped (2 + 1 overflow) — keep Cloud Run max-instances=1.
# SCRAPER0_DATABASE_URL=postgresql+psycopg://scraper0:PASSWORD@/scraper0?host=/cloudsql/PROJECT:REGION:INSTANCE
# SCRAPER0_DB_POOL_SIZE=2
# SCRAPER0_DB_MAX_OVERFLOW=1

# --- encryption at rest for AI keys / portal sessions (required outside local). Generate: uv run scraper0 gen-secret-key
# SCRAPER0_SECRET_KEY=

# --- first-boot bootstrap (idempotent; afterwards manage everything in the dashboard)
SCRAPER0_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SCRAPER0_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# OPTIONAL. AI providers are managed in the dashboard (Admin → Shared AI providers). This only pre-seeds a
# shared Groq provider on an empty install, e.g. to carry over web-scraper's existing key.
# SCRAPER0_BOOTSTRAP_GROQ_API_KEY=
SCRAPER0_BOOTSTRAP_LEGACY_TENANT=hashtaglocal

# --- legacy POST /api/v1/scrape (hashtaglocal-backend). Keyless calls → the legacy tenant while the backend migrates.
SCRAPER0_LEGACY_KEYLESS=false
SCRAPER0_LEGACY_TENANT_SLUG=hashtaglocal
# X-Backend-Url allowlist (SSRF guard for FETCH_EVENTS dedupe callbacks), comma-separated
SCRAPER0_ALLOWED_BACKEND_URLS=

# --- jobs: thread (local) | inline | cloud_tasks (Cloud Run)
SCRAPER0_JOB_MODE=thread
# SCRAPER0_INTERNAL_TOKEN=               # shared secret for /internal/* (Cloud Tasks + Cloud Scheduler)
# SCRAPER0_PUBLIC_BASE_URL=https://scraper0-api-xxxx.a.run.app
# SCRAPER0_CLOUD_TASKS_QUEUE=projects/PROJECT/locations/REGION/queues/scraper0-jobs

# --- dashboard
SCRAPER0_FRONTEND_URL=http://localhost:3000
SCRAPER0_CORS_ORIGINS=["http://localhost:3000"]
SCRAPER0_COOKIE_SECURE=false

# --- connectors
SCRAPER0_CAPTCHA_SOLVER=llm             # llm | easyocr | auto   (easyocr needs: uv sync --extra ocr)

# --- crawling
SCRAPER0_RENDER_JS=auto                 # auto: render JavaScript-only pages in headless Chromium | never
